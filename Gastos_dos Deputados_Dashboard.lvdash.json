      "config": {
        "source": "dados_es.gold.resumo_despesas_deputado",
        "measures": [
          {
            "name": "gasto_total",
            "expr": "SUM(valor_total_liquido)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          },
          {
            "name": "gasto_bruto",
            "expr": "SUM(valor_total_bruto)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_notas",
            "expr": "SUM(total_notas_fiscais)"
          }
        ],
        "version": "1.1",
        "comment": "Resumo por deputado das despesas da cota parlamentar",
        "dimensions": [
          {
            "name": "deputado_id",
            "expr": "deputado_id"
          },
          {
            "name": "nome_deputado",
            "expr": "nome_deputado"
          },
          {
            "name": "sigla_partido",
            "expr": "sigla_partido"
          },
          {
            "name": "sigla_uf",
            "expr": "sigla_uf"
          }
        ]
      }
    },
    {
      "name": "top_deputados_gasto",
      "displayName": "Top 15 deputados por gasto",
      "config": {
        "source": "SELECT deputado_id, nome_deputado, sigla_partido, sigla_uf, valor_total_liquido FROM dados_es.gold.resumo_despesas_deputado ORDER BY valor_total_liquido DESC LIMIT 15",
        "measures": [
          {
            "name": "gasto_total",
            "expr": "SUM(valor_total_liquido)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          }
        ],
        "version": "1.1",
        "comment": "Top 15 deputados por gasto líquido total",
        "dimensions": [
          {
            "name": "deputado_id",
            "expr": "deputado_id"
          },
          {
            "name": "nome_deputado",
            "expr": "nome_deputado"
          },
          {
            "name": "sigla_partido",
            "expr": "sigla_partido"
          },
          {
            "name": "sigla_uf",
